# Root .env.example — copy each app's example into apps/<app>/.env
# This file documents every var used across the monorepo.

# ------------------------------------------------------------------
# apps/api
# ------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:4000

# Database
MONGO_URI=mongodb://localhost:27017/tripbng_b2b
MONGO_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-min-64-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-min-64-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12

# CORS — comma-separated allowlist
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info

# 2FA
TOTP_ISSUER=TripBng

# ------------------------------------------------------------------
# apps/web
# ------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=TripBng
