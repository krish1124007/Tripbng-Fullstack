NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:4000

MONGO_URI=mongodb://localhost:27017/tripbng_b2b
MONGO_POOL_SIZE=10

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-very-long-random-string-min-64-chars-aaaaaaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=change-me-different-long-random-string-min-64-chars-bbbbbbbbbbbbbbbbb
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12

CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=debug
TOTP_ISSUER=TripBng

# eTrav Flight API (B2B aggregator)
# Set ETRAV_ENABLED=true to register the adapter on boot.
# eTrav uses credentials-in-body auth + IP whitelisting — calls from non-whitelisted
# IPs will be rejected even with valid credentials. See adapters/etrav/README.md.
ETRAV_ENABLED=false
ETRAV_BASE_URL=https://stg-api.codemagen.net
ETRAV_USER_ID=
ETRAV_PASSWORD=
ETRAV_IP_ADDRESS=
ETRAV_IMEI_NUMBER=tripbng-server
ETRAV_TIMEOUT_MS=15000

# Kafila V2 Flight API (B2B aggregator — Phase 1 scaffolding, search/book land later)
# Login body uses `{ userId, apiKey, apiSecret }` (Postman is authoritative; the PDF
# docs showing `{ userId, password }` are stale). Token is 8h JWT, cached in Redis
# under KAFILA_JWT_CACHE_KEY, refreshed proactively at 7h 30min.
# Default disabled; flip KAFILA_ENABLED=true once UAT creds land + IP is whitelisted.
KAFILA_ENABLED=false
KAFILA_BASE_URL=http://staging.kafilaholidays.in
KAFILA_USER_ID=
KAFILA_API_KEY=
KAFILA_API_SECRET=
KAFILA_COMPANY_ID=
KAFILA_CREDENTIAL_TYPE=TEST
KAFILA_SALES_CHANNEL=API
KAFILA_HTTP_TIMEOUT_MS=30000
KAFILA_HTTP_MAX_RETRIES=2
KAFILA_RATE_LIMIT_RPS=5
KAFILA_JWT_CACHE_KEY=kafila:jwt
KAFILA_JWT_TTL_SECONDS=27000
KAFILA_PRIORITY=6

# AirIQ FIT Flight API (B2B aggregator — AAS v1.0)
# Search-only first cut. Custom Basic Auth: Base64(AgentID*Username:Password).
# Token from /Login is valid until 23:59:59 IST (cached in-process).
# Test endpoint is plaintext HTTP; production URL "will be provided by mail" (HTTPS TBC).
# Multi-city is NOT supported — only oneway / roundtrip.
AIRIQ_ENABLED=false
AIRIQ_BASE_URL=http://testairiq.mywebcheck.in/TravelAPI.svc
AIRIQ_AGENT_ID=
AIRIQ_USERNAME=
AIRIQ_PASSWORD=
AIRIQ_APP_TYPE=API
AIRIQ_API_VERSION=V1.0
AIRIQ_HTTP_TIMEOUT_MS=30000

# ASEGO travel insurance — B2B partner API.
# All transactional calls except createPolicy are plain JSON; createPolicy is
# AES-256-CBC + Base64. Secret key MUST be 32 chars and IV MUST be 16 chars
# (env validation refuses to boot otherwise).
ASEGO_ENABLED=false
ASEGO_BASE_URL=https://dolphin.asego.in:8080
ASEGO_API_PREFIX=/ext/b2b/v1
ASEGO_USER_AGENT=TripBNG-API/1.0
ASEGO_PARTNER_ID=
ASEGO_SIGN=
ASEGO_REFERENCE=
ASEGO_SECRET_KEY=
ASEGO_INIT_VECTOR=
ASEGO_BRANCH_SIGN=
ASEGO_BRANCH_NAME=
ASEGO_REQUEST_TIMEOUT_MS=30000
ASEGO_RETRY_COUNT=2
ASEGO_CACHE_TTL_MASTER=86400
ASEGO_CACHE_TTL_REASONS=2592000

# ICICI Orange PG / Pay Gateway (env fallback only — production should use PaymentGatewayConfig in DB)
# UAT endpoints. Swap to https://pgpay.icicibank.com/tsp/pg/... for PROD.
ICICI_ORANGE_PG_ENV=UAT
ICICI_ORANGE_PG_MERCHANT_ID=
ICICI_ORANGE_PG_AGGREGATOR_ID=
ICICI_ORANGE_PG_KEY=
ICICI_ORANGE_PG_RETURN_URL=
ICICI_ORANGE_PG_ADVICE_URL=
ICICI_ORANGE_PG_INITIATE_SALE_URL=https://pgpayuat.icicibank.com/tsp/pg/api/v2/initiateSale
ICICI_ORANGE_PG_COMMAND_URL=https://pgpayuat.icicibank.com/tsp/pg/api/command
ICICI_ORANGE_PG_SETTLEMENT_DETAILS_URL=https://pgpayuat.icicibank.com/tsp/pg/api/settlementDetails
ICICI_ORANGE_PG_USER_CANCEL_URL=https://pgpayuat.icicibank.com/tsp/pg/api/userCancel

# PhonePe Standard Checkout V2 (env fallback only)
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_MERCHANT_ID=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
PHONEPE_RETURN_URL=

# Field-level encryption (AES-256-GCM) for PII + gateway credentials.
# 32 bytes hex = 64 chars. Generate with: `node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"`.
# Production: provision via AWS KMS / Doppler / Infisical, NEVER commit.
FIELD_ENCRYPTION_KEY=

# Sentry — leave blank to fall back to pino-only error visibility.
SENTRY_DSN=

# ────────── Email (SMTP) ──────────
# Used by the alert-dispatch worker for booking confirmations,
# cancellations, hold-expiry warnings, etc. Connection pool is
# 5 conns × 100 messages per conn. Templates live in
# `apps/api/src/services/alerts/templates/*.ts`.
#
# Example (SendGrid):
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_SECURE=false      # true only for 465 (TLS), false for 587 (STARTTLS)
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxxx
#   SMTP_FROM="TripBng <no-reply@yourdomain.com>"
#   SMTP_REPLY_TO=support@yourdomain.com
#
# Leave blank to skip email dispatch — the alert worker logs a
# warning per send attempt but the booking flow continues.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# Ops alert inbox — receives partner inquiries, circuit-breaker trips,
# manual-issuance reminders, and any {kind: 'ops'} recipient. Leave
# blank to suppress ops-only emails (booking/topup alerts still send).
OPS_ALERT_EMAIL=

# Gmail/Workspace example — App Password required if 2FA is on (generate
# at https://myaccount.google.com/apppasswords). Personal Gmail caps at
# 500 messages/day; Workspace at 2000/day.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=alerts@yourdomain.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx   # 16-char app password

# ────────── WhatsApp Business Cloud API ──────────
# Used to send booking-confirmation ticket links via WhatsApp.
# Requires a Meta Business account + an approved message template
# (default template name: ticket_confirmation).
#
#   WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxx
#   WHATSAPP_PHONE_NUMBER_ID=123456789012345
#   WHATSAPP_TEMPLATE_NAME=ticket_confirmation
#
# Leave blank to skip WhatsApp dispatch — booking flow degrades
# gracefully (email + in-app still fire if configured).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=ticket_confirmation

# ────────── GST invoice settings (flight) ──────────
# GST rates as basis points (1800 = 18%). Air-passenger transport:
# 5% on economy domestic, 12% on business / first.
TRIPBNG_FLIGHT_ECONOMY_GST_BP=500
TRIPBNG_FLIGHT_BUSINESS_GST_BP=1200

# ────────── Wallet shadow mode (Phase 9) ──────────
# When true, every successful payment also computes — without writing! —
# what the new waterfall would produce: credit settlement vs. wallet
# split, DI incentive, TDS. Result lands as a structured `info` log line
# for offline comparison against the live ledger. Run for ~2 weeks
# before flipping the waterfall on as the authoritative path.
SHADOW_WALLET=false

# ────────── Wallet waterfall live cutover (Phase 13) ──────────
# When true, paymentService.markSuccess routes every agency-attributed
# successful payment through waterfall.applyPayment instead of the legacy
# walletService.credit. This activates the credit-settlement split for
# CREDIT-module agencies, writes CreditSettlement snapshot rows, and
# hands off to the async DI incentive worker.
#
# Rollout: flip ON only after SHADOW_WALLET has run long enough to be
# confident the splits match. Flipping OFF restores the legacy path with
# zero code revert — the legacy walletService.credit branch is still in
# the file as the rollback safety net.
#
# When WATERFALL_LIVE=true, the SHADOW_WALLET observation log is
# automatically suppressed (the baseline it diffed against no longer
# exists, so the comparison would be noise).
WATERFALL_LIVE=false
