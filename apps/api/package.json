{
  "name": "@tripbng/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/scripts/seed.ts",
    "asego:smoke": "tsx src/scripts/asego-smoke-all.ts",
    "asego:smoke:crypto": "tsx src/scripts/asego-crypto-parity.ts",
    "asego:smoke:master": "tsx src/scripts/asego-smoke.ts",
    "asego:smoke:issue": "tsx src/scripts/asego-issue-smoke.ts",
    "asego:smoke:lifecycle": "tsx src/scripts/asego-lifecycle-smoke.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@tripbng/shared": "workspace:*",
    "argon2": "^0.41.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.4",
    "ms": "^2.1.3",
    "nanoid": "^5.0.9",
    "nodemailer": "^8.0.7",
    "otplib": "^12.0.1",
    "pdfkit": "^0.15.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tripbng/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/ms": "^0.7.34",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
